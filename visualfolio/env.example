# Create secure credentials
DJANGO_SECRET_KEY=create_a_secure_django_secret_key_here
POSTGRES_PASSWORD=create_a_secure_database_password_here

# Replace 'your-domain.com' with your domain
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com

# Defaults (leave unchanged)
DJANGO_DEBUG=false
POSTGRES_DB=visualfolio
POSTGRES_USER=visualfolio

# Bank connection (Enable Banking): application ID and private key, base64-encoded on one line
ENABLE_BANKING_APPLICATION_ID=
ENABLE_BANKING_KEY_CONTENT=

# GoCardless Bank Account Data: existing credentials only (new signups are closed)
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=
