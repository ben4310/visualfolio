erDiagram

    %% -------------------------
    %% ENTITY: AssetClass
    %% -------------------------
    ASSET_CLASS {
        Char(63) name PK
        Char(7) color
        Float volatility_index
    }

    %% -------------------------
    %% ENTITY: Asset
    %% -------------------------
    ASSET {
        Char(15) code PK
        Char(127) name
        Char(7) symbol
        Boolean is_liquid
        %% symbol is nullable
        %% FK to AssetClass(name)
    }

    %% -------------------------
    %% ENTITY: CustomUser (extends AbstractUser)
    %%   Represented here for completeness
    %% -------------------------
    CUSTOM_USER {
        Int id PK
        DateTime last_update
        DateTime last_full_refresh
        Char(10) sync_frequency
        PositiveSmallInt sync_preferred_hour
        DateTime last_auto_sync
        Char(10) theme
        Char(63) user_timezone
        %% plus AbstractUser fields (username, email, password, etc.)
        %% sync_frequency choices: manual, 6h, 12h, 24h (default: 24h)
        %% sync_preferred_hour: 0-23, default 5
        %% theme choices: system, light, dark (default: system)
        %% user_timezone: IANA timezone, default UTC
        %% All timestamp fields are nullable
    }

    %% -------------------------
    %% ENTITY: Account
    %% -------------------------
    ACCOUNT {
        Int id PK
        Char(255) name
        Char(255) country
        UUID requisition_id
        Char(7) color
        Char(64) gocardless_institution_id
        Int transaction_total_days
        DateTime access_expires_at
        %% FK to CustomUser(id)
        %% requisition_id is nullable and unique
        %% gocardless_institution_id is nullable
        %% transaction_total_days is nullable
        %% access_expires_at is nullable
        %% unique(name, user)
    }

    %% -------------------------
    %% ENTITY: AccountAsset
    %% Links Account to Asset, stores GoCardless metadata and sync state
    %% -------------------------
    ACCOUNT_ASSET {
        Int id PK
        Char(64) gocardless_account_id
        Char(10) sync_status
        DateTime last_successful_sync
        Text last_sync_error
        Int account_success_limit
        Int account_success_remaining
        DateTime account_success_reset
        %% FK to Account(id)
        %% FK to Asset(code)
        %% gocardless_account_id is nullable and unique
        %% sync_status choices: idle, syncing (default: idle)
        %% last_successful_sync is nullable
        %% last_sync_error is nullable
        %% account_success_limit is nullable
        %% account_success_remaining is nullable
        %% account_success_reset is nullable
        %% unique(account, asset)
        %% unique(gocardless_account_id) when not null
    }

    %% -------------------------
    %% ENTITY: Transaction
    %% Includes both regular transactions and trade sides
    %% -------------------------
    TRANSACTION {
        Int id PK
        Char(255) entity
        Float amount
        DateTime datetime
        Char(31) category
        Boolean is_trade_side
        Int paired_transaction_id
        %% FK to Account(id)
        %% FK to Asset(code)
        %% FK to Transaction(id) via paired_transaction (self-reference)
        %% amount cannot be zero (validator)
        %% datetime cannot be in future (validator)
        %% entity is required for non-trade transactions, nullable for trade sides
        %% category is nullable
        %% paired_transaction_id is nullable
        %% is_trade_side defaults to False, indexed
        %% asset must be a Fiat Currency asset class
        %% Trade sides are linked via paired_transaction
    }

    %% -------------------------
    %% ENTITY: BalanceHistory
    %% -------------------------
    BALANCE_HISTORY {
        Int id PK
        Date date
        Float balance
        %% balance must be >= 0.0
        %% FK to Account(id)
        %% FK to Asset(code)
        %% unique(account, asset, date)
        %% ordering: (account, asset, date)
    }

    %% -------------------------
    %% ENTITY: GoCardlessToken
    %% Singleton model for app-level API tokens
    %% -------------------------
    GOCARDLESS_TOKEN {
        Int id PK
        Text access_token
        DateTime access_expires_at
        Text refresh_token
        DateTime refresh_expires_at
        %% Only one row should exist (pk=1)
    }

    %% -------------------------
    %% ENTITY: Requisition
    %% Tracks GoCardless bank connection flow
    %% -------------------------
    REQUISITION {
        UUID id PK
        Char(64) institution_id
        Char(255) institution_name
        Char(255) institution_country
        Char(2) status
        URL link
        DateTime created_at
        UUID agreement_id
        Int transaction_total_days
        Int access_valid_for_days
        %% FK to CustomUser(id)
        %% status choices: CR, GC, UA, RJ, SA, GA, LN, EX (default: CR)
        %% agreement_id is nullable
        %% created_at is auto_now_add
    }

    %% -------------------------
    %% RELATIONSHIPS
    %% -------------------------

    %% AssetClass (1) -- (N) Asset
    ASSET_CLASS ||--o{ ASSET : "1 - n"

    %% CustomUser (1) -- (N) Account
    CUSTOM_USER ||--o{ ACCOUNT : "1 - n"

    %% Account (1) -- (N) AccountAsset
    ACCOUNT ||--o{ ACCOUNT_ASSET : "1 - n"

    %% Asset (1) -- (N) AccountAsset
    ASSET ||--o{ ACCOUNT_ASSET : "1 - n"

    %% Account (1) -- (N) Transaction
    ACCOUNT ||--o{ TRANSACTION : "1 - n"

    %% Asset (1) -- (N) Transaction
    ASSET ||--o{ TRANSACTION : "1 - n"

    %% Transaction (1) -- (0..1) Transaction (self-reference for trades)
    TRANSACTION ||--o| TRANSACTION : "paired_transaction"

    %% Account (1) -- (N) BalanceHistory
    ACCOUNT ||--o{ BALANCE_HISTORY : "1 - n"

    %% Asset (1) -- (N) BalanceHistory
    ASSET ||--o{ BALANCE_HISTORY : "1 - n"

    %% CustomUser (1) -- (N) Requisition
    CUSTOM_USER ||--o{ REQUISITION : "1 - n"
